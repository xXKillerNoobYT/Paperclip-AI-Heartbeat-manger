{
  "name": "paperclip-ai-heartbeat-manager",
  "version": "0.1.0",
  "description": "Dry-run heartbeat manager for pacing Paperclip agent wakes against provider subscription usage windows.",
  "type": "module",
  "private": false,
  "bin": {
    "paperclip-heartbeat-manager": "./bin/paperclip-heartbeat-manager.js"
  },
  "scripts": {
    "test": "node --test",
    "decide": "node ./bin/paperclip-heartbeat-manager.js decide --dry-run --config ./examples/heartbeat-manager.config.json",
    "hold-plan": "node ./bin/paperclip-heartbeat-manager.js hold-plan --dry-run --config ./examples/heartbeat-manager.config.json --hold-snapshot ./examples/hold-snapshot.json",
    "report": "node ./bin/paperclip-heartbeat-manager.js report --dry-run --config ./examples/heartbeat-manager.config.json --output ./reports/operator-dashboard.html"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "paperclip",
    "heartbeat",
    "scheduler",
    "quota",
    "dry-run"
  ],
  "license": "GPL-3.0"
}
