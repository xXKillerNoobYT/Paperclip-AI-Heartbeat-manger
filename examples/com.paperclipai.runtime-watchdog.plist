<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.paperclipai.runtime-watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/IA/GitHub/Paperclip-AI-Heartbeat-manger/bin/paperclip-runtime-watchdog.py</string>
	</array>
	<key>StartInterval</key>
	<integer>600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/IA/.paperclip-watchdog/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/IA/.paperclip-watchdog/launchd.err.log</string>
</dict>
</plist>
